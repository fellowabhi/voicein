[Unit]
Description=VoiceIn tray dictation (STT + LLM paste)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=@VOICEIN_REPO@
ExecStart=@VOICEIN_REPO@/scripts/voicein-run.sh
Restart=on-failure
RestartSec=20
StartLimitBurst=5
StartLimitIntervalSec=300

[Install]
WantedBy=graphical-session.target
